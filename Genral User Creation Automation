Step 2: Bulk Create Active Directory Users
On the AD server:
Import-Csv C:\Temp\linoop_users.csv | ForEach-Object {

    $Password = ConvertTo-SecureString "Welcome@123" -AsPlainText -Force

    New-ADUser `
        -Name $_."Full Name" `
        -SamAccountName $_.Username `
        -UserPrincipalName $_."AD User" `
        -EmailAddress $_.Mailbox `
        -AccountPassword $Password `
        -Enabled $true `
        -ChangePasswordAtLogon $true
}
