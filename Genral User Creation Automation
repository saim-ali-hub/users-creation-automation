Python script:
import csv

with open("users.txt") as f:
    users = [line.strip().split(",") for line in f]

with open("linoop_users.csv","w",newline="") as out:
    writer = csv.writer(out)

    writer.writerow([
        "Full Name",
        "Username",
        "Mailbox",
        "AD User",
        "Zoom User",
        "Personal Email"
    ])

    for fullname,email in users:

        username = fullname.lower().replace(" ",".")

        writer.writerow([
            fullname,
            username,
            f"{username}@linoop.us",
            f"{username}@corp.linoop.us",
            f"{username}@linoop.us",
            email
        ])
