Step 2: Generate Usernames
generate_users.py
import csv

with open('users.csv') as f:
    users=list(csv.DictReader(f))

for user in users:

    username=user['FullName'].lower().replace(" ",".")

    print(f"""
Name: {user['FullName']}
Username: {username}
Mailbox: {username}@linoop.us
AD: {username}@corp.linoop.us
Zoom: {username}@linoop.us
""")
