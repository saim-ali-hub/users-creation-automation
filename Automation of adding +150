import smtplib
from email.message import EmailMessage

def send_email(
        smtp_server,
        sender,
        recipient,
        body):

    msg = EmailMessage()

    msg["Subject"] = (
        "LINOOP Account Information"
    )

    msg["From"] = sender
    msg["To"] = recipient

    msg.set_content(body)

    smtp = smtplib.SMTP(
        smtp_server,
        587)

    smtp.send_message(msg)

    smtp.quit()
