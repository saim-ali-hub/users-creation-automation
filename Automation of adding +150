3. Username Generator
modules/username.py
def generate_username(fullname, existing):

    username = fullname.lower().strip()
    username = ".".join(username.split())

    original = username
    counter = 1

    while username in existing:
        username = f"{original}{counter}"
        counter += 1

    existing.add(username)

    return username
