5. cPanel Module
modules/cpanel.py
import requests

def create_mailbox(
        server,
        token,
        username,
        password):

    url = (
        f"https://{server}:2083/"
        "execute/Email/add_pop"
    )

    payload = {
        "email": username,
        "domain": "linoop.us",
        "password": password,
        "quota": 2048
    }

    headers = {
        "Authorization":
        f"cpanel root:{token}"
    }

    response = requests.post(
        url,
        headers=headers,
        data=payload,
        verify=False,
        timeout=30
    )

    return response.json()
