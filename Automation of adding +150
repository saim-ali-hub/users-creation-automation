Skeleton:
import requests

def create_zoom_user(
        token,
        email,
        first_name,
        last_name):

    payload = {

        "action": "create",

        "user_info": {

            "email": email,

            "type": 1,

            "first_name": first_name,

            "last_name": last_name
        }
    }

    r = requests.post(
        "https://api.zoom.us/v2/users",
        headers={
            "Authorization":
            f"Bearer {token}"
        },
        json=payload
    )

    return r.status_code
