FastAPI Upload Endpoint
routes/upload.py
from fastapi import APIRouter, UploadFile

router = APIRouter()

@router.post("/upload")
async def upload(file: UploadFile):

    path = f"uploads/{file.filename}"

    with open(path, "wb") as f:
        f.write(await file.read())

    return {
        "status": "uploaded"
    }
