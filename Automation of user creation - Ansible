________________________________________
Phase 2 - Generate Usernames
Role:
roles/generate_accounts/tasks/main.yml
- name: Generate account details
  set_fact:
    processed_users: "{{ processed_users | default([]) + [ {

      'fullname': item.fullname,
      'personal_email': item.personal_email,

      'username':
      item.fullname
      | lower
      | replace(' ','.'),

      'mailbox':
      (item.fullname
      | lower
      | replace(' ','.'))
      ~ '@linoop.us',

      'ad_user':
      (item.fullname
      | lower
      | replace(' ','.'))
      ~ '@corp.linoop.us',

      'zoom_user':
      (item.fullname
      | lower
      | replace(' ','.'))
      ~ '@linoop.us'

    } ] }}"
  loop: "{{ users }}"
Result:
processed_users:

  - fullname: Sajjad Shafiq
    username: sajjad.shafiq
    mailbox: sajjad.shafiq@linoop.us
    ad_user: sajjad.shafiq@corp.linoop.us
    zoom_user: sajjad.shafiq@linoop.us
